diff --git a/util.c b/util.c
index 837e342..ccac89e 100644
--- a/util.c
+++ b/util.c
@@ -2579,3 +2579,254 @@ usage:
 nla_put_failure:
 	return -ENOBUFS;
 }
+
+/* Maximum number of frequencies we collect per band query */
+#define GET_BAND_FREQS_MAX 256
+
+struct band_freqs_cb_arg {
+	enum nl80211_band band;
+	uint32_t *freqs;
+	int count;
+	int max;
+};
+
+static int band_freqs_finish_handler(struct nl_msg *msg, void *arg)
+{
+	int *ret = arg;
+	*ret = 0;
+	return NL_SKIP;
+}
+
+static int band_freqs_ack_handler(struct nl_msg *msg, void *arg)
+{
+	int *ret = arg;
+	*ret = 0;
+	return NL_STOP;
+}
+
+static int band_freqs_error_handler(struct sockaddr_nl *nla,
+				    struct nlmsgerr *err, void *arg)
+{
+	int *ret = arg;
+	*ret = err->error;
+	return NL_STOP;
+}
+
+/*
+ * Collect the wiphy index and protocol-features flags from a
+ * GET_INTERFACE or GET_PROTOCOL_FEATURES response.
+ */
+struct band_freqs_wiphy_arg {
+	uint32_t wiphy_idx;
+	bool     has_wiphy;
+	bool     has_split_dump;
+};
+
+static int band_freqs_iface_handler(struct nl_msg *msg, void *arg)
+{
+	struct band_freqs_wiphy_arg *ctx = arg;
+	struct genlmsghdr *gnlh = nlmsg_data(nlmsg_hdr(msg));
+	struct nlattr *tb[NL80211_ATTR_MAX + 1];
+
+	nla_parse(tb, NL80211_ATTR_MAX,
+		  genlmsg_attrdata(gnlh, 0), genlmsg_attrlen(gnlh, 0), NULL);
+
+	if (tb[NL80211_ATTR_WIPHY]) {
+		ctx->wiphy_idx = nla_get_u32(tb[NL80211_ATTR_WIPHY]);
+		ctx->has_wiphy = true;
+	}
+	return NL_SKIP;
+}
+
+static int band_freqs_feat_handler(struct nl_msg *msg, void *arg)
+{
+	struct band_freqs_wiphy_arg *ctx = arg;
+	struct genlmsghdr *gnlh = nlmsg_data(nlmsg_hdr(msg));
+	struct nlattr *tb[NL80211_ATTR_MAX + 1];
+
+	nla_parse(tb, NL80211_ATTR_MAX,
+		  genlmsg_attrdata(gnlh, 0), genlmsg_attrlen(gnlh, 0), NULL);
+
+	if (tb[NL80211_ATTR_PROTOCOL_FEATURES]) {
+		uint32_t feat = nla_get_u32(tb[NL80211_ATTR_PROTOCOL_FEATURES]);
+		if (feat & NL80211_PROTOCOL_FEATURE_SPLIT_WIPHY_DUMP)
+			ctx->has_split_dump = true;
+	}
+	return NL_SKIP;
+}
+
+static int band_freqs_handler(struct nl_msg *msg, void *arg)
+{
+	struct band_freqs_cb_arg *ctx = arg;
+	struct genlmsghdr *gnlh = nlmsg_data(nlmsg_hdr(msg));
+	struct nlattr *tb_msg[NL80211_ATTR_MAX + 1];
+	struct nlattr *tb_band[NL80211_BAND_ATTR_MAX + 1];
+	struct nlattr *tb_freq[NL80211_FREQUENCY_ATTR_MAX + 1];
+	static struct nla_policy freq_policy[NL80211_FREQUENCY_ATTR_MAX + 1] = {
+		[NL80211_FREQUENCY_ATTR_FREQ]     = { .type = NLA_U32 },
+		[NL80211_FREQUENCY_ATTR_DISABLED] = { .type = NLA_FLAG },
+	};
+	struct nlattr *nl_band, *nl_freq;
+	int rem_band, rem_freq;
+
+	nla_parse(tb_msg, NL80211_ATTR_MAX,
+		  genlmsg_attrdata(gnlh, 0), genlmsg_attrlen(gnlh, 0), NULL);
+
+	if (!tb_msg[NL80211_ATTR_WIPHY_BANDS])
+		return NL_SKIP;
+
+	nla_for_each_nested(nl_band, tb_msg[NL80211_ATTR_WIPHY_BANDS], rem_band) {
+		if ((enum nl80211_band)nl_band->nla_type != ctx->band)
+			continue;
+
+		nla_parse(tb_band, NL80211_BAND_ATTR_MAX,
+			  nla_data(nl_band), nla_len(nl_band), NULL);
+
+		if (!tb_band[NL80211_BAND_ATTR_FREQS])
+			continue;
+
+		nla_for_each_nested(nl_freq, tb_band[NL80211_BAND_ATTR_FREQS], rem_freq) {
+			uint32_t freq;
+
+			nla_parse(tb_freq, NL80211_FREQUENCY_ATTR_MAX,
+				  nla_data(nl_freq), nla_len(nl_freq), freq_policy);
+
+			if (!tb_freq[NL80211_FREQUENCY_ATTR_FREQ])
+				continue;
+			if (tb_freq[NL80211_FREQUENCY_ATTR_DISABLED])
+				continue;
+
+			freq = nla_get_u32(tb_freq[NL80211_FREQUENCY_ATTR_FREQ]);
+			if (ctx->count < ctx->max)
+				ctx->freqs[ctx->count++] = freq;
+		}
+	}
+
+	return NL_SKIP;
+}
+
+/* Helper: send one netlink message and collect responses via cb. */
+static int band_freqs_send_recv(struct nl80211_state *state,
+				struct nl_msg *msg, struct nl_cb *cb)
+{
+	int err;
+
+	err = nl_send_auto_complete(state->nl_sock, msg);
+	if (err < 0)
+		return err;
+
+	err = 1;
+	nl_cb_set(cb, NL_CB_FINISH, NL_CB_CUSTOM, band_freqs_finish_handler, &err);
+	nl_cb_set(cb, NL_CB_ACK,    NL_CB_CUSTOM, band_freqs_ack_handler,    &err);
+	nl_cb_err(cb, NL_CB_CUSTOM, band_freqs_error_handler, &err);
+
+	while (err > 0)
+		nl_recvmsgs(state->nl_sock, cb);
+
+	return err;
+}
+
+int get_band_freqs(struct nl80211_state *state, int ifindex,
+		   enum nl80211_band band,
+		   uint32_t *freqs, int max_freqs)
+{
+	struct band_freqs_wiphy_arg wctx = { .has_wiphy = false,
+					     .has_split_dump = false };
+	struct band_freqs_cb_arg fctx = {
+		.band  = band,
+		.freqs = freqs,
+		.count = 0,
+		.max   = max_freqs,
+	};
+	struct nl_msg *msg;
+	struct nl_cb *cb;
+	int err;
+
+	cb = nl_cb_alloc(NL_CB_DEFAULT);
+	if (!cb)
+		return -ENOMEM;
+
+	/* ----------------------------------------------------------------
+	 * Step 1: GET_INTERFACE to resolve ifindex -> wiphy index.
+	 * This mirrors how __handle_cmd() puts NL80211_ATTR_WIPHY for
+	 * CIB_PHY commands; GET_WIPHY must be keyed by wiphy index.
+	 * ---------------------------------------------------------------- */
+	msg = nlmsg_alloc();
+	if (!msg) { err = -ENOMEM; goto out_cb; }
+
+	if (!genlmsg_put(msg, 0, 0, state->nl80211_id, 0, 0,
+			 NL80211_CMD_GET_INTERFACE, 0)) {
+		err = -ENOBUFS; goto out_msg;
+	}
+	NLA_PUT_U32(msg, NL80211_ATTR_IFINDEX, ifindex);
+
+	nl_cb_set(cb, NL_CB_VALID, NL_CB_CUSTOM, band_freqs_iface_handler, &wctx);
+	err = band_freqs_send_recv(state, msg, cb);
+	nlmsg_free(msg);
+	msg = NULL;
+
+	if (err < 0 || !wctx.has_wiphy)
+		goto out_cb;
+
+	/* ----------------------------------------------------------------
+	 * Step 2: GET_PROTOCOL_FEATURES to check split-wiphy-dump support.
+	 * Mirrors handle_info() calling "features -q" before GET_WIPHY.
+	 * ---------------------------------------------------------------- */
+	msg = nlmsg_alloc();
+	if (!msg) { err = -ENOMEM; goto out_cb; }
+
+	if (!genlmsg_put(msg, 0, 0, state->nl80211_id, 0, 0,
+			 NL80211_CMD_GET_PROTOCOL_FEATURES, 0)) {
+		err = -ENOBUFS; goto out_msg;
+	}
+
+	nl_cb_set(cb, NL_CB_VALID, NL_CB_CUSTOM, band_freqs_feat_handler, &wctx);
+	err = band_freqs_send_recv(state, msg, cb);
+	nlmsg_free(msg);
+	msg = NULL;
+
+	if (err < 0)
+		goto out_cb;
+
+	/* ----------------------------------------------------------------
+	 * Step 3: GET_WIPHY keyed by wiphy index.
+	 * Use NLM_F_DUMP + SPLIT_WIPHY_DUMP when the kernel supports it
+	 * (required for 6 GHz — the kernel splits band data across
+	 * multiple responses and only sends 6 GHz in the extra messages).
+	 * ---------------------------------------------------------------- */
+	msg = nlmsg_alloc();
+	if (!msg) { err = -ENOMEM; goto out_cb; }
+
+	if (wctx.has_split_dump) {
+		if (!genlmsg_put(msg, 0, 0, state->nl80211_id, 0,
+				 NLM_F_DUMP, NL80211_CMD_GET_WIPHY, 0)) {
+			err = -ENOBUFS; goto out_msg;
+		}
+		NLA_PUT_FLAG(msg, NL80211_ATTR_SPLIT_WIPHY_DUMP);
+	} else {
+		if (!genlmsg_put(msg, 0, 0, state->nl80211_id, 0,
+				 0, NL80211_CMD_GET_WIPHY, 0)) {
+			err = -ENOBUFS; goto out_msg;
+		}
+	}
+	NLA_PUT_U32(msg, NL80211_ATTR_WIPHY, wctx.wiphy_idx);
+
+	nl_cb_set(cb, NL_CB_VALID, NL_CB_CUSTOM, band_freqs_handler, &fctx);
+	err = band_freqs_send_recv(state, msg, cb);
+	nlmsg_free(msg);
+	msg = NULL;
+
+	if (err < 0)
+		goto out_cb;
+
+	nl_cb_put(cb);
+	return fctx.count;
+
+nla_put_failure:
+	err = -ENOBUFS;
+out_msg:
+	nlmsg_free(msg);
+out_cb:
+	nl_cb_put(cb);
+	return err;
+}
