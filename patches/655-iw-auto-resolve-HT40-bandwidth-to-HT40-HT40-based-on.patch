diff --git a/util.c b/util.c
index 837e342..0b39d32 100644
--- a/util.c
+++ b/util.c
@@ -598,17 +598,52 @@ static int parse_freqs(struct chandef *chandef, int argc, char **argv,
  * user by giving "NOHT" instead.
  *
  * The working specifier if chan is set are:
- *   <channel> [6G] [NOHT|HT20|HT40+|HT40-|5MHz|10MHz|80MHz|160MHz|320MHz]
+ *   <channel> [6G] [NOHT|HT20|HT40|HT40+|HT40-|5MHz|10MHz|80MHz|160MHz|320MHz]
  * channel number defaults to 5G or 2G band unless 6G is specified.
  *
  * And if frequency is set:
- *   <freq> [NOHT|HT20|HT40+|HT40-|5MHz|10MHz|80MHz|160MHz|320MHz]
+ *   <freq> [NOHT|HT20|HT40|HT40+|HT40-|5MHz|10MHz|80MHz|160MHz|320MHz]
  *   <control freq> [5|10|20|40|80|80+80|160|320] [<center1_freq> [<center2_freq>]]
  *
  * If the mode/channel width is not given the NOHT is assumed.
  *
  * Return: Number of used arguments, zero or negative error number otherwise
  */
+/*
+ * resolve_ht40 - Determine HT40+ or HT40- from the control frequency.
+ *
+ * For 2.4 GHz: channels 1-6 (freq <= 2437) use HT40+, channels 7-13 use HT40-.
+ * For 5 GHz / 6 GHz: the lower channel of each 40 MHz pair is HT40+, the upper
+ * is HT40-. This is determined by whether the channel index within its 40 MHz
+ * block is even (HT40+) or odd (HT40-).
+ */
+static const struct chanmode *resolve_ht40(unsigned int freq)
+{
+	static const struct chanmode ht40plus = { .name = "HT40+",
+						   .width = NL80211_CHAN_WIDTH_40,
+						   .freq1_diff = 10,
+						   .chantype = NL80211_CHAN_HT40PLUS };
+	static const struct chanmode ht40minus = { .name = "HT40-",
+						   .width = NL80211_CHAN_WIDTH_40,
+						   .freq1_diff = -10,
+						   .chantype = NL80211_CHAN_HT40MINUS };
+
+	if (freq >= 2412 && freq <= 2472) {
+		/* 2.4 GHz: ch 1-6 -> HT40+, ch 7-13 -> HT40- */
+		return (freq <= 2437) ? &ht40plus : &ht40minus;
+	} else if (freq >= 5180 && freq < 5900) {
+		/* 5 GHz: pairs are (36,40),(44,48),(52,56),(60,64),...
+		 * lower channel of each pair -> HT40+, upper -> HT40- */
+		return (((freq - 5180) / 20) % 2 == 0) ? &ht40plus : &ht40minus;
+	} else if (freq >= 5955 && freq <= 7115) {
+		/* 6 GHz: same pairing rule */
+		return (((freq - 5955) / 20) % 2 == 0) ? &ht40plus : &ht40minus;
+	}
+
+	/* Fallback: let the kernel reject it */
+	return &ht40plus;
+}
+
 int parse_freqchan(struct chandef *chandef, bool chan, int argc, char **argv,
 		   int *parsed, bool freq_in_khz)
 {
@@ -626,6 +661,10 @@ int parse_freqchan(struct chandef *chandef, bool chan, int argc, char **argv,
 		  .width = NL80211_CHAN_WIDTH_40,
 		  .freq1_diff = -10,
 		  .chantype = NL80211_CHAN_HT40MINUS },
+		{ .name = "HT40",
+		  .width = NL80211_CHAN_WIDTH_40,
+		  .freq1_diff = 0,
+		  .chantype = -1 },
 		{ .name = "NOHT",
 		  .width = NL80211_CHAN_WIDTH_20_NOHT,
 		  .freq1_diff = 0,
@@ -736,6 +775,11 @@ int parse_freqchan(struct chandef *chandef, bool chan, int argc, char **argv,

 	/* channel mode given, use it and return. */
 	if (chanmode_selected) {
+		/* Resolve plain "HT40" to HT40+ or HT40- based on channel */
+		if (chanmode_selected->freq1_diff == 0 &&
+		    chanmode_selected->width == NL80211_CHAN_WIDTH_40)
+			chanmode_selected = resolve_ht40(freq);
+
 		chandef->center_freq1 = get_cf1(chanmode_selected, freq);

 		/* For non-S1G frequency */
