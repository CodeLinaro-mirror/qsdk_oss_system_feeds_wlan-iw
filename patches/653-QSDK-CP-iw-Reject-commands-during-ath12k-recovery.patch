From f96bfe5784974a2c2159b3c254ad6d550c00a343 Mon Sep 17 00:00:00 2001
From: Gautham Kumar Senthilkumaran <gauthamk@qti.qualcomm.com>
Date: Thu, 6 Aug 2026 19:40:35 +0530
Subject: [PATCH] QSDK:CP: iw: Reject commands during ath12k bypass/SSR

Currently, iw has no visibility into whether the underlying
ath12k device is mid-SSR recovery or bypass operation, so
commands can be issued against a device that is being torn
down and recreated, hanging or failing unpredictably instead
of returning an immediate, well-defined error.

Add iw_accept_cmd(), which globs /sys/kernel/debug/ath12k/*/accept_cmd
and checks each SoC's flag. The file reads 0 when commands are blocked
(bypass or SSR in progress) and 1 when the group is idle. Call it in
__handle_cmd() right after device index resolution, returning -EBUSY
instead of proceeding when commands are not accepted. Device-agnostic
commands (iw list, iw event) do not reach __handle_cmd() and are
unaffected.

Patch-dependency: None

Signed-off-by: Gautham Kumar Senthilkumaran <gauthamk@qti.qualcomm.com>

--- a/iw.c
+++ b/iw.c
@@ -13,6 +13,7 @@
 #include <fcntl.h>
 #include <unistd.h>
 #include <stdbool.h>
+#include <glob.h>
 #include <linux/netlink.h>

 #include <netlink/genl/genl.h>
@@ -257,4 +258,31 @@ static void version(void)
 	printf("iw version %s\n", iw_version);
 }

+static int iw_accept_cmd(void)
+{
+	glob_t g;
+	size_t i;
+	FILE *fp;
+	int blocked = 0;
+	char val;
+	/* accept_cmd reads 0 when bypass/SSR is in progress (commands
+	 * blocked), 1 when the group is idle and commands are accepted.
+	 */
+	if (glob("/sys/kernel/debug/ath12k/*/accept_cmd",
+		 0, NULL, &g) != 0)
+		return 1;
+	for (i = 0; i < g.gl_pathc; i++) {
+		fp = fopen(g.gl_pathv[i], "r");
+		if (!fp)
+			continue;
+		if (fread(&val, 1, 1, fp) == 1 && val == '0')
+			blocked = 1;
+		fclose(fp);
+		if (blocked)
+			break;
+	}
+	globfree(&g);
+	return !blocked;
+}
+
 static int phy_lookup(char *name)
@@ -412,6 +441,10 @@ static int __handle_cmd(struct nl80211_state *state, enum id_input idby,
 	if (devidx < 0)
 		return -errno;

+	if (!iw_accept_cmd()) {
+		fprintf(stderr, "ath12k bypass/SSR in progress, command rejected\n");
+		return -EBUSY;
+	}
 	section = *argv;
 	argc--;
 	argv++;
