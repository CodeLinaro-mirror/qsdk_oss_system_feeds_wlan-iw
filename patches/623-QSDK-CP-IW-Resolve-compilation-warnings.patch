From 0a352fc23a61c898ad0bbc3348304bec26d6b8de Mon Sep 17 00:00:00 2001
From: Rajat Soni <quic_rajson@quicinc.com>
Date: Wed, 16 Oct 2024 13:11:10 +0530
Subject: [PATCH] QSDK: CP: IW: Resolve compilation warnings

Some warnings are seen during iw compilation:

134917 scan.c:675:13: warning: 'print_ds' defined but not used [-Wunused-function]
134918   675 | static void print_ds(const uint8_t type, uint8_t len, const uint8_t *data,
134919       |             ^~~~~~~~
134920 scan.c:620:13: warning: 'print_rm_enabled_capabilities' defined but not used [-Wunused-function]
134921   620 | static void print_rm_enabled_capabilities(const uint8_t type, uint8_t len,
134922       |             ^~~~~~~~~~~~~~~~~~~~~~~~~~~~~

To resolve these warning we need to include compile these functions only when
IWFULL is enabled.

Fixes: I844b5a6304e ("iw: Adding new patch for build issue")

Patch-dependency: 501-compilation-fix.patch

Patch-work: None

Signed-off-by: Rajat Soni <quic_rajson@quicinc.com>
---
 scan.c | 15 +++++++--------
 1 file changed, 7 insertions(+), 8 deletions(-)

diff --git a/scan.c b/scan.c
index 995e242..2743408 100644
--- a/scan.c
+++ b/scan.c
@@ -615,7 +615,6 @@ static void print_supprates(const uint8_t type, uint8_t len,
 	}
 	printf("\n");
 }
-#endif
 
 static void print_rm_enabled_capabilities(const uint8_t type, uint8_t len,
 			    const uint8_t *data,
@@ -781,6 +780,7 @@ static void print_ap_channel_report(const uint8_t type, uint8_t len, const uint8
 	}
 	printf("\n");
 }
+#endif
 
 static void print_cipher(const uint8_t *data)
 {
@@ -1140,7 +1140,6 @@ static const char* ntype_11u(uint8_t t)
 	default: return "Reserved";
 	}
 }
-#endif
 
 static const char* vgroup_11u(uint8_t t)
 {
@@ -1309,6 +1308,7 @@ static void print_tx_power_envelope(const uint8_t type, uint8_t len,
 			printf("\t\t * %s: %i dBm\n", power_names[i], power_val);
 	}
 }
+#endif
 
 static const char *ht_secondary_offset[4] = {
 	"no secondary",
@@ -1512,8 +1512,6 @@ static void print_capabilities(const uint8_t type, uint8_t len,
 
 	printf("\n");
 }
-#endif
-
 
 static void print_tim(const uint8_t type, uint8_t len, const uint8_t *data,
 		      const struct print_ies_data *ie_buffer)
@@ -1531,6 +1529,7 @@ static void print_ibssatim(const uint8_t type, uint8_t len, const uint8_t *data,
 {
 	printf(" %d TUs\n", (data[1] << 8) + data[0]);
 }
+#endif
 
 static void print_vht_capa(const uint8_t type, uint8_t len, const uint8_t *data,
 			   const struct print_ies_data *ie_buffer)
@@ -1593,7 +1592,6 @@ static void print_supp_op_classes(const uint8_t type, uint8_t len,
 				break;
 		}
 }
-#endif
 
 static void print_measurement_pilot_tx(const uint8_t type, uint8_t len,
 				       const uint8_t *data,
@@ -1658,6 +1656,7 @@ static void print_obss_scan_params(const uint8_t type, uint8_t len,
 	printf("\t\t * OBSS Scan Activity Threshold: %d.%02d %%\n",
 		((data[13] << 8) | data[12]) / 100, ((data[13] << 8) | data[12]) % 100);
 }
+#endif
 
 static void print_secchan_offs(const uint8_t type, uint8_t len,
 			       const uint8_t *data,
@@ -1678,7 +1677,6 @@ static void print_bss_load(const uint8_t type, uint8_t len, const uint8_t *data,
 	printf("\t\t * channel utilisation: %d/255\n", data[2]);
 	printf("\t\t * available admission capacity: %d [*32us]\n", (data[4] << 8) | data[3]);
 }
-#endif
 
 static void print_mesh_conf(const uint8_t type, uint8_t len,
 			    const uint8_t *data,
@@ -1712,6 +1710,7 @@ static void print_mesh_conf(const uint8_t type, uint8_t len,
 	if (data[6] & 0x40)
 		printf("\t\t\t Mesh Power Save Level\n");
 }
+#endif
 
 struct ie_print {
 	const char *name;
@@ -1789,6 +1788,7 @@ static const struct ie_print ieprinters[] = {
 #endif
 };
 
+#ifdef IW_FULL
 static void print_wifi_wpa(const uint8_t type, uint8_t len, const uint8_t *data,
 			   const struct print_ies_data *ie_buffer)
 {
@@ -2120,7 +2120,6 @@ static void print_wifi_wps(const uint8_t type, uint8_t len, const uint8_t *data,
 	}
 }
 
-#ifdef IW_FULL
 static const struct ie_print wifiprinters[] = {
 	[1] = { "WPA", print_wifi_wpa, 2, 255, BIT(PRINT_SCAN), },
 	[2] = { "WMM", print_wifi_wmm, 1, 255, BIT(PRINT_SCAN), },
@@ -2726,6 +2725,7 @@ COMMAND(scan, abort, "",
 	NL80211_CMD_ABORT_SCAN, 0, CIB_NETDEV, handle_scan_abort,
 	"Abort ongoing scan");
 
+#ifdef IW_FULL
 static int handle_start_sched_scan(struct nl80211_state *state,
 				   struct nl_msg *msg,
 				   int argc, char **argv, enum id_input id)
@@ -2743,7 +2743,6 @@ static int handle_stop_sched_scan(struct nl80211_state *state,
 	return 0;
 }
 
-#ifdef IW_FULL
 COMMAND(scan, sched_start,
 	SCHED_SCAN_OPTIONS,
 	NL80211_CMD_START_SCHED_SCAN, 0, CIB_NETDEV, handle_start_sched_scan,
-- 
