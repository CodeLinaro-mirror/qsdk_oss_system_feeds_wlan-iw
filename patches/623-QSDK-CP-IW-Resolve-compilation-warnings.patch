From 63cc0c774e559edea8e4c3fad1a4bed82e182564 Mon Sep 17 00:00:00 2001
From: Rajat Soni <quic_rajson@quicinc.com>
Date: Tue, 22 Oct 2024 11:50:40 +0530
Subject: [PATCH] QSDK: CP: IW: Resolve compilation warnings

Some warnings are seen during iw compilation:

134917 scan.c:675:13: warning: 'print_ds' defined but not used [-Wunused-function]
134918   675 | static void print_ds(const uint8_t type, uint8_t len, const uint8_t *data,
134919       |             ^~~~~~~~
134920 scan.c:620:13: warning: 'print_rm_enabled_capabilities' defined but not used [-Wunused-function]
134921   620 | static void print_rm_enabled_capabilities(const uint8_t type, uint8_t len,
134922       |             ^~~~~~~~~~~~~~~~~~~~~~~~~~~~~

To resolve these warning we need to include compile these functions only when
IWFULL is enabled.

Fixes: I844b5a6304e ("iw: Adding new patch for build issue")

Patch-dependency: 501-compilation-fix.patch

Patch-work: None

Signed-off-by: Rajat Soni <quic_rajson@quicinc.com>
---
 event.c     |  5 ++++-
 interface.c |  5 +++--
 scan.c      | 16 +++++++++++-----
 station.c   |  6 ++++--
 util.c      |  1 -
 5 files changed, 22 insertions(+), 11 deletions(-)

diff --git a/event.c b/event.c
index bde65e8..d42d52b 100644
--- a/event.c
+++ b/event.c
@@ -103,7 +103,7 @@ static void print_frame(struct print_event_args *args, struct nlattr *attr)
 		printf(" %.02x", frame[i]);
 	printf("]");
 }
-#endif
+
 static void parse_cqm_event(struct nlattr **attrs)
 {
 	static struct nla_policy cqm_policy[NL80211_ATTR_CQM_MAX + 1] = {
@@ -299,6 +299,7 @@ static void parse_wowlan_wake_event(struct nlattr **attrs)
 	if (tb[NL80211_WOWLAN_TRIG_UNPROTECTED_DEAUTH_DISASSOC])
 		printf("\t* unprotected deauth/disassoc\n");
 }
+#endif
 
 extern struct vendor_event *__start_vendor_event[];
 extern struct vendor_event *__stop_vendor_event;
@@ -306,6 +307,7 @@ extern struct vendor_event *__stop_vendor_event;
 // Dummy to force the section to exist
 VENDOR_EVENT(0xffffffff, 0xffffffff, NULL);
 
+#ifdef IW_FULL
 static void parse_vendor_event(struct nlattr **attrs, bool dump)
 {
 	__u32 vendor_id, subcmd;
@@ -913,6 +915,7 @@ static void parse_assoc_comeback(struct nlattr **attrs, int command)
 	printf("assoc comeback bssid %s timeout %d\n",
 	       macbuf, timeout);
 }
+#endif
 
 static int print_event(struct nl_msg *msg, void *arg)
 {
