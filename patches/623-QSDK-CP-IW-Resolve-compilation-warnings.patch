 			   const struct print_ies_data *ie_buffer)
@@ -1595,7 +1599,6 @@ static void print_supp_op_classes(const uint8_t type, uint8_t len,
 				break;
 		}
 }
-#endif
 
 static void print_measurement_pilot_tx(const uint8_t type, uint8_t len,
 				       const uint8_t *data,
@@ -1660,6 +1663,7 @@ static void print_obss_scan_params(const uint8_t type, uint8_t len,
 	printf("\t\t * OBSS Scan Activity Threshold: %d.%02d %%\n",
 		((data[13] << 8) | data[12]) / 100, ((data[13] << 8) | data[12]) % 100);
